<Window x:Class="CodexUsage.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Usage" Width="48" Height="84" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" UseLayoutRounding="True">
  <Border Margin="3" CornerRadius="18" BorderThickness="0.7" BorderBrush="#B3FFFFFF"
          MouseLeftButtonDown="PointerDown" MouseMove="PointerMove" MouseLeftButtonUp="PointerUp"
          MouseRightButtonUp="OpenDetails" Cursor="Hand">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D4F5FCFA" Offset="0"/>
        <GradientStop Color="#BDE9F3F1" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="1"/><RowDefinition Height="37"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" VerticalAlignment="Center">
        <TextBlock Text="5h" FontSize="8" Foreground="#697A7B" HorizontalAlignment="Center"/>
        <TextBlock x:Name="FiveHourValue" Text="—" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12" Foreground="#17383B" HorizontalAlignment="Center"/>
      </StackPanel>
      <Border Grid.Row="1" Height="0.5" Background="#338A9D9D" Margin="13,0"/>
      <StackPanel Grid.Row="2" VerticalAlignment="Center">
        <TextBlock Text="周" FontSize="8" Foreground="#697A7B" HorizontalAlignment="Center"/>
        <TextBlock x:Name="WeeklyValue" Text="—" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12" Foreground="#17383B" HorizontalAlignment="Center"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
