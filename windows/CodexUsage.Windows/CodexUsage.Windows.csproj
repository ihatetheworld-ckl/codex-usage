<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CodexUsage</AssemblyName>
    <RootNamespace>CodexUsage.Windows</RootNamespace>
    <StartupObject>CodexUsage.Windows.Program</StartupObject>
    <ApplicationIcon>../../Assets/AppIcon.ico</ApplicationIcon>
    <Version>0.3.2</Version>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CodexUsage.Core/CodexUsage.Core.csproj" />
    <EmbeddedResource Include="../../Assets/AppIcon.ico" LogicalName="CodexUsage.AppIcon.ico" />
  </ItemGroup>
</Project>
